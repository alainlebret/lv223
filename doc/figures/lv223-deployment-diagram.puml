@startuml lv223-deployment-diagram

!define NODE_COLOR lightblue
!define DATABASE_COLOR lightgreen
!define AGENT_COLOR lightyellow

skin rose

node "Planet Server Machine" {
    folder "Planet Server" {
        [PlanetServer]
        [SeasonHandler]
        [HealthStateHandler]
        [MetamorphosisHandler]
        ...
    }
}

node "Robot Colony Agent Machine" {
    folder "Robot Colony Agent" {
        [ColonyManager]
        [PlanetServerConnection]
        [RobotEnvironmentFacade]
        [ResponseDispatcher]
        [Cartographer]
        [Farmer]
        [Harvester]
        [Miner]
        [Pipeliner]
        [Centralizer]
    }
}

node "GUI Client Machine" {
    folder "GUI Client" {
        [PlanetGUI]
    }
}

[PlanetServer] --> [SeasonHandler] : uses
[PlanetServer] --> [HealthStateHandler] : uses
[PlanetServer] --> [MetamorphosisHandler] : uses
[ColonyManager] --> [PlanetServerConnection] : manages
[ColonyManager] --> [RobotEnvironmentFacade] : uses
[ColonyManager] --> [Centralizer] : coordinates via
[PlanetServerConnection] --> [PlanetServer] : JSON over TCP (actions / endOfTurn)
[RobotEnvironmentFacade] --> [PlanetServerConnection] : uses
[RobotEnvironmentFacade] --> [ResponseDispatcher] : dispatches via
[Cartographer] --> [RobotEnvironmentFacade] : interacts
[Farmer] --> [RobotEnvironmentFacade] : interacts
[Harvester] --> [RobotEnvironmentFacade] : interacts
[Miner] --> [RobotEnvironmentFacade] : interacts
[Pipeliner] --> [RobotEnvironmentFacade] : interacts
[PlanetGUI] --> [PlanetServer] : binary-framed JSON (push)

@enduml
